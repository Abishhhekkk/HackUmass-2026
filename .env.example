# Copy to .env, replace placeholders, and never commit .env.
INGEST_API_KEY=replace-with-a-long-random-secret
# Same value on the Jetson and the cloud API => snapshot uploads are compressed + encrypted.
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# When set on the server, plaintext uploads are rejected. Leave unset for plaintext (dev).
# RESCUE_PAYLOAD_KEY=
# Leave DATABASE_URL unset for SQLite; use your Tiger Cloud connection string for Postgres:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
# SNAPSHOT_DIR=/var/lib/rescuesight/snapshots
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# MAX_UPLOAD_BYTES=10485760

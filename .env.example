# Copy to .env (repo root), replace placeholders, and never commit .env.
# The cloud API reads this file when started with uvicorn; variables already set win.
# Required whenever the API is reachable from outside (tunnel, cloud host): uploads need this key.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=replace-with-a-long-random-secret
# Leave DATABASE_URL unset for SQLite; use your Tiger Data service connection string for Postgres:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Mission reports: every N seconds (0 = on demand only), and the minimum gap per mission
# REPORT_INTERVAL_S=300
# REPORT_MIN_GAP_S=20
# MAX_UPLOAD_BYTES=10485760

# Optional, laptop only: a PERMANENT public address instead of a new trycloudflare.com one each
# start. Free ngrok account > Domains (one free static domain) and > Your Authtoken.
# NGROK_DOMAIN=your-name.ngrok-free.app
# NGROK_AUTHTOKEN=
